# Host port for the HuggingHack web UI. 127.0.0.1:7860 accepts only connections from
# this host, for when a reverse proxy on the same host is the only way in.
HUGGINGHACK_PORT=7860

# Desktop default. On your NAS, replace this with an absolute host path such as:
# /volume1/AI/models
# /mnt/tank/ai/models
# /share/Container/models
MODEL_STORAGE_PATH=./models

# Durable storage backend: filesystem (default) or s3.
# With s3, MODEL_STORAGE_PATH remains a working cache for inference engines.
MODEL_STORAGE_BACKEND=filesystem

# Metadata database. Leave blank for the default SQLite file in /data.
# For an external PostgreSQL server:
# DATABASE_URL=postgresql://hugginghack:password@database-host:5432/hugginghack
DATABASE_URL=
# PostgreSQL connections kept open and reused (1-100). Keep it below the server's
# max_connections, less what other clients need. Not used with SQLite.
DATABASE_POOL_SIZE=10

# Used by docker-compose.postgres.yml. Choose a long URL-safe password.
# POSTGRES_DB=hugginghack
# POSTGRES_USER=hugginghack
# POSTGRES_PASSWORD=replace-with-a-long-random-password

# S3-compatible storage (AWS S3, MinIO, Ceph, Cloudflare R2, and similar).
# Uncomment these when MODEL_STORAGE_BACKEND=s3.
# S3_BUCKET=my-model-bucket
# S3_PREFIX=models
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=http://minio:9000
# S3_ADDRESSING_STYLE=path
# S3_USE_SSL=false
# S3_VERIFY_SSL=true
# S3_STORAGE_CLASS=
# Keys for this bucket. Leave them unset to use the AWS_* variables below instead.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# S3_MAX_CONCURRENCY=4
# S3_MULTIPART_CHUNK_MB=64

# More buckets (MinIO, Ceph, AWS, ...) as extra storage targets. Keep the JSON on
# one line. Ids are permanent: 1-40 lowercase letters, digits, or hyphens.
# Credentials are never written here; name the variables that hold them.
# STORAGE_TARGETS_JSON=[{"id":"minio-main","name":"MinIO models","bucket":"models","prefix":"models","endpoint_url":"http://minio:9000","region":"us-east-1","addressing_style":"path","use_ssl":false,"access_key_env":"MINIO_MAIN_KEY","secret_key_env":"MINIO_MAIN_SECRET"}]
# MINIO_MAIN_KEY=
# MINIO_MAIN_SECRET=
STORAGE_TARGETS_JSON=[]
# Where new uploads and downloads go: local, s3 (MODEL_STORAGE_BACKEND=s3), or a
# target id above. Defaults to s3 when configured, otherwise local.
DEFAULT_STORAGE_TARGET=
# Where the site keeps its own files (profile pictures, git history for clones):
# local (the DATA_DIR folder) or an S3 target id above, to run on S3 and the database
# only. They go in a _system folder under that target's prefix, or SYSTEM_STORAGE_PREFIX.
SYSTEM_STORAGE_TARGET=local
# SYSTEM_STORAGE_PREFIX=models/_system

# Use the normal AWS credential environment variables, an attached IAM role,
# or another provider in boto3's credential chain. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Pull models from other machines with vLLM, git clone, or the hf CLI.
# HuggingHack serves the Hugging Face Hub protocol, so clients only need
# HF_ENDPOINT=http://NAS-IP:7860. Without a token, pulls can read every model visible
# to all accounts. A personal API token (Account -> API tokens) used as HF_TOKEN or as
# the git password also reaches its owner's private repositories.
# Set false to require a token for every pull.
HUB_API_ENABLED=true
# Address other machines use to reach this server, shown in the copy-paste
# commands. Leave blank to use the address in your browser.
# PUBLIC_URL=http://192.168.0.10:7860
PUBLIC_URL=

# Server-side downloads from Hugging Face (API only, no page in the web UI).
# Off by default: an air-gapped server cannot reach Hugging Face, so models
# arrive by upload instead. Turn on only where HF_ENDPOINT is reachable.
HF_DOWNLOADS_ENABLED=false
# Used only when HF_DOWNLOADS_ENABLED=true. Use a READ token for private or
# gated repositories.
HF_TOKEN=
HF_ENDPOINT=https://huggingface.co
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_WORKERS_PER_JOB=4

# Local accounts are enabled by default. The first browser visit creates the owner.
ACCOUNTS_ENABLED=true

# Single sign-on with OpenID Connect (Authentik, Keycloak, Entra ID, Okta, Dex, ...).
# Leave OIDC_ISSUER empty to use HuggingHack passwords only. Passwords keep working
# alongside single sign-on, so a local administrator can always get in.
# The callback URL to register with the provider is PUBLIC_URL + /api/auth/oidc/callback.
OIDC_ISSUER=
# OIDC_ISSUER=https://authentik.example.internal/application/o/hugginghack/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Shown on the button: "Sign in with <name>". Defaults to "single sign-on".
# OIDC_PROVIDER_NAME=Authentik
# Role for accounts created at their first sign-in: viewer, member, or admin.
# Administrators change it afterwards under Admin -> Users. Avoid admin here.
OIDC_DEFAULT_ROLE=viewer
# Optional: only members of these comma-separated groups may sign in.
OIDC_ALLOWED_GROUPS=
# OIDC_GROUPS_CLAIM=groups
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_SCOPES=openid profile email
# Only needed when the callback must differ from PUBLIC_URL + /api/auth/oidc/callback.
# OIDC_REDIRECT_URL=https://hugginghack.example.internal/api/auth/oidc/callback
# A PEM file inside the container for an internal certificate authority.
# OIDC_CA_BUNDLE=/data/internal-ca.pem

# auto (default): session cookies are marked Secure when the request arrives over
# HTTPS, directly or through a proxy sending X-Forwarded-Proto: https, so plain-HTTP
# air-gapped servers keep working. Set true or false to force it.
SECURE_COOKIES=auto
SESSION_TTL_HOURS=720
# Other web origins allowed to call the API with users' cookies, comma-separated
# (for example a separately hosted web UI). Leave empty: the built-in UI needs none,
# and the Vite dev server proxies /api with X-Forwarded-Host (xfwd), so it needs none.
CORS_ORIGINS=
# Host names this server answers to, comma-separated, such as
# hugginghack.example.internal,192.168.0.10. Other Host headers get 400, which blocks
# DNS rebinding from web pages. Empty answers to any name. localhost and 127.0.0.1
# are always allowed, for the container health check. List every name and IP that
# other machines use in HF_ENDPOINT and git clone URLs too, or their pulls get 400.
ALLOWED_HOSTS=
# The address of your reverse proxy, so the real client address is used for the
# sign-in limits and session list. Set to your reverse proxy's IP; never *, when the
# app is exposed directly that lets clients fake their IP.
FORWARDED_ALLOW_IPS=127.0.0.1
# The interactive API reference at /api/docs and /openapi.json. Off by default.
API_DOCS_ENABLED=false

# Browser uploads are resumable and streamed in bounded chunks.
UPLOAD_CHUNK_MB=8
MAX_UPLOAD_SIZE_GB=1024

# Optional network inference destinations. Keep this JSON on one line.
# Ollama receives model blobs over HTTP. vLLM targets point to the separate,
# authenticated HuggingHack vLLM agent and need the NAS model folder mounted
# at the configured remote_model_root on that device.
RUNTIME_TARGETS_JSON=[]
# Example:
# RUNTIME_TARGETS_JSON=[{"id":"ollama-rig","name":"Ollama GPU","kind":"ollama","base_url":"http://192.168.0.36:11434","keep_alive":"15m"},{"id":"vllm-rig","name":"vLLM GPU","kind":"vllm","base_url":"http://192.168.0.35:8090","remote_model_root":"/mnt/nas/models","token_env":"VLLM_AGENT_TOKEN"}]
RUNTIME_WORKERS=2

# Optional bearer token for GET /api/runtimes, GET /api/runtime-jobs, and
# POST /api/runtimes/{target_id}/load. Use a long random value.
RUNTIME_API_TOKEN=

# Forwarded into the HuggingHack container for the example vLLM target above.
# Configure the identical value on the remote vLLM agent.
VLLM_AGENT_TOKEN=

# The user and group the container runs as. The default 0:0 is root. To run
# unprivileged, set the owner of MODEL_STORAGE_PATH and ./data (find them with
# `id your-user`), and make both folders writable by that user first, for example
# `sudo chown -R 1000:1000 models data`. See docs/AIRGAPPED.md, section 3.
PUID=0
PGID=0
